{
  "_metadata": {
    "major_version": 1,
    "minor_version": 1
  },
  "display_information": {
    "name": "Inbox Manager Bot",
    "description": "Posts interested-reply drafts in Slack for edit and approve.",
    "background_color": "#1f2937"
  },
  "features": {
    "bot_user": {
      "display_name": "Inbox Manager Bot",
      "always_online": true
    }
  },
  "oauth_config": {
    "scopes": {
      "bot": [
        "chat:write",
        "chat:write.customize",
        "reactions:write",
        "reactions:read",
        "channels:history",
        "groups:history",
        "groups:read"
      ]
    }
  },
  "settings": {
    "org_deploy_enabled": false,
    "socket_mode_enabled": false,
    "token_rotation_enabled": false
  }
}
